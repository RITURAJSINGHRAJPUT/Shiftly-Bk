# Required
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/shiftly?schema=public"
JWT_SECRET="change-me-to-a-random-string"
PORT=3001

# Optional — only needed for specific commands or scenarios
# CORS_ORIGIN=https://your-frontend-domain.com
# RATE_LIMIT_DISABLED=true
# Comma separated keys for GET /api/public/staff. Unset means the endpoint
# answers 503 — it is never open without a key. Mint one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# PUBLIC_API_KEYS=key-one,key-two
# Origins allowed to call the public API from a browser. Exact match, so the
# apex and www forms are different origins and both usually need listing.
# Unset means no browser on any other site can read it; server-to-server is
# unaffected either way.
# PUBLIC_API_ORIGINS=https://example.com,https://www.example.com
# Comma separated keys for POST /api/attendance/import (the KGAPI biometric
# punch-log bridge — see server/src/scripts/syncKgapiAttendance.js). Kept
# separate from PUBLIC_API_KEYS so a leaked read-only key can never be used to
# write attendance data. Same 503-if-unset behaviour; mint the same way:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ATTENDANCE_IMPORT_KEYS=key-one,key-two

# --- Attendance source ---------------------------------------------------
# The database holding the raw punch log (a Neon instance mirroring what the
# biometric readers record). Unlike the on-site KGAPI box this is reachable
# from the deployed server, so Shiftly pulls from it rather than being pushed
# to. Unset means POST /api/attendance/sync answers 503 instead of half-running.
# ATTENDANCE_DATABASE_URL=postgresql://...
#
# Where the punches live in that database. Defaults below match the KGAPI feed
# this replaces; they are validated as plain SQL identifiers at load, and the
# server refuses to start on anything else.
# ATTENDANCE_SOURCE_TABLE=attendance_punches
# ATTENDANCE_SOURCE_USERID_COL=userid
# ATTENDANCE_SOURCE_TIME_COL=edatetime
# ATTENDANCE_SOURCE_NAME_COL=emp_name
# ATTENDANCE_SOURCE_DEVICE_COL=evtsourcedet
#
# Only when the timestamp column is `timestamptz`: the zone its wall-clock
# readings should be interpreted in. Leave unset for a plain `timestamp`, where
# the stored value is already the answer.
# ATTENDANCE_SOURCE_TIMEZONE=Asia/Kolkata

# --- Overtime ------------------------------------------------------------
# The hour a working day begins. A punch before it counts towards the previous
# day, so an 18:00-02:00 shift is one attendance row rather than two. 0 (the
# default) is a plain midnight boundary.
#
# Effectively part of the schema: the result is half of Attendance's unique
# key, so changing it once rows exist makes the next import write a *second*
# row for the same shift instead of updating the first. Decide before the first
# production sync.
# ATTENDANCE_DAY_CUTOFF_HOUR=5
#
# Overtime before this date records its minutes but is never raised for
# approval — otherwise the first historical sync drops years of it into a head
# chef's queue at once.
# OVERTIME_EFFECTIVE_FROM=2026-09-01

# ALLOW_DEMO_SEED=true
# SEED_PASSWORD=your-test-password
# SUPERADMIN_NAME=Your Name
# SOURCE_DATABASE_URL=postgresql://...
# TARGET_DATABASE_URL=postgresql://...
