generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  HR
  OUTLET_MANAGER
  MASTER_OF_HOUSE
  HEAD_CHEF
  STAFF
}

enum Department {
  KITCHEN
  SERVICE
  HOUSEKEEPING
}

enum ShiftStatus {
  ASSIGNED
  COMPLETED
  MISSED
  SWAPPED
  CANCELLED
}

enum AttendanceStatus {
  CHECKED_IN
  CHECKED_OUT
  ABSENT
  LATE
  ON_LEAVE
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  EMERGENCY
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COVERAGE_PENDING
}

enum NotificationType {
  SHIFT_ASSIGNED
  SHIFT_CHANGED
  EMERGENCY_COVER_REQUEST
  EMERGENCY_COVER_ACCEPTED
  EMERGENCY_AUTO_ASSIGNED
  LEAVE_APPROVED
  LEAVE_REJECTED
  ATTENDANCE_REMINDER
  TRANSFER_REQUESTED
  TRANSFER_APPROVED
  TRANSFER_REJECTED
  GENERAL
}

enum TransferType {
  OUTLET
  STATION
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Organization {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brands    Brand[]
}

model Brand {
  id             String       @id @default(uuid())
  name           String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  /// This brand's kitchen stations, in the order they appear on its shift sheet.
  /// Ordered rather than a set: the sheet's row order is how the managers read
  /// it. Capiche runs Pizza and Pasta, Aiko runs Sushi, Side and Wok — the two
  /// never had a single shared list.
  stations       String[]     @default([])
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  outlets        Outlet[]

  @@index([organizationId])
}

model Outlet {
  id        String     @id @default(uuid())
  name      String     @unique
  address   String?
  brandId   String
  brand     Brand      @relation(fields: [brandId], references: [id])
  latitude  Float      @default(21.17)
  longitude Float      @default(72.83)
  radius    Int        @default(100)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]
  shifts    Shift[]
  shiftTemplates ShiftTemplate[]
  incomingTransfers TransferRequest[]

  @@index([brandId])
}

model Employee {
  id            String         @id @default(uuid())
  employeeCode  String?        @unique
  name          String
  email         String?        @unique
  phone         String?
  password      String         @default("")
  /// Set when an admin issues a one-time password. Until the account chooses its
  /// own, its token is scoped to the change-password route and nothing else, so
  /// a temporary password can never be left in place as a working credential.
  mustChangePassword Boolean   @default(false)
  avatar        String?
  role          Role           @default(STAFF)
  /// Null for the organisation-wide roles — SUPER_ADMIN, ADMIN and HR belong to
  /// no restaurant and work no department. They were required columns, so those
  /// accounts had to name an outlet they had nothing to do with, which then
  /// showed up on their profile and in that outlet's headcount.
  ///
  /// Nothing reads them for those roles: outletScope() returns an empty filter
  /// for GLOBAL_SCOPE_ROLES, and the allocator only rosters ROSTERABLE_ROLES.
  department    Department?
  outletId      String?
  outlet        Outlet?        @relation(fields: [outletId], references: [id])
  skills        String[]       @default([])
  isActive      Boolean        @default(true)
  joinDate      DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  shifts        Shift[]
  attendance    Attendance[]
  leaves        Leave[]
  notifications Notification[]
  transferRequests TransferRequest[]

  @@index([outletId])
  @@index([department])
  @@index([role])
}

model Shift {
  id         String      @id @default(uuid())
  date       DateTime
  startTime  String
  endTime    String
  section    String?
  status     ShiftStatus @default(ASSIGNED)
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id])
  outletId   String
  outlet     Outlet      @relation(fields: [outletId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([date])
  @@index([employeeId])
  @@index([outletId])
  @@index([date, outletId])
}

model Attendance {
  id          String           @id @default(uuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id])
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  checkInLat  Float?
  checkInLng  Float?
  checkOutLat Float?
  checkOutLng Float?
  withinRange Boolean          @default(false)
  status      AttendanceStatus @default(ABSENT)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId])
}

model Leave {
  id          String      @id @default(uuid())
  employeeId  String
  employee    Employee    @relation(fields: [employeeId], references: [id])
  type        LeaveType
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      LeaveStatus @default(PENDING)
  isEmergency Boolean     @default(false)
  coveredById String?
  expiresAt   DateTime?
  approvedBy  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
}

model Notification {
  id         String           @id @default(uuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id])
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  actionUrl  String?
  actionData String?
  expiresAt  DateTime?
  createdAt  DateTime         @default(now())

  @@index([employeeId])
  @@index([isRead])
  @@index([createdAt])
}

/// A recurring staffing requirement at one outlet: "Pizza station, 12:00-21:00,
/// 4 people". Auto-allocation fills `headcount` slots per template per day.
model ShiftTemplate {
  id         String     @id @default(uuid())
  name       String
  outletId   String
  outlet     Outlet     @relation(fields: [outletId], references: [id])
  department Department
  section    String?
  startTime  String
  endTime    String
  /// How many people this pattern needs. Previously implicit at 1, which capped
  /// every outlet at one shift per pattern per day regardless of its size.
  headcount  Int        @default(1)
  /// Which weekdays this pattern runs, as JS getDay() numbers (0 = Sunday …
  /// 6 = Saturday) — the form the allocator and the week grid both already hold
  /// dates in, so neither end converts. Defaults to all seven, so a pattern
  /// written before this field existed behaves exactly as it did.
  daysOfWeek Int[]      @default([0, 1, 2, 3, 4, 5, 6])
  /// Which of the day's two shifts this is — the sheet's "Shift 1" / "Shift 2".
  /// Usually derivable from startTime, but not always: a station that runs only
  /// an evening shift is entered on the Shift 2 row and has to stay there rather
  /// than silently sliding up to Shift 1 on the next reload.
  slot       Int        @default(1)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([outletId])
}

model TransferRequest {
  id               String         @id @default(uuid())
  employeeId       String
  employee         Employee       @relation(fields: [employeeId], references: [id])
  type             TransferType

  fromOutletId     String?
  fromDepartment   Department?
  fromSkills       String[]       @default([])

  targetOutletId   String?
  targetOutlet     Outlet?        @relation(fields: [targetOutletId], references: [id])
  targetDepartment Department?
  targetSkills     String[]       @default([])

  reason           String?
  status           TransferStatus @default(PENDING)
  approvedBy       String?
  rejectionReason  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([targetOutletId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String?
  entityId  String?
  actorId   String?
  actorName String?
  actorRole String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}
